<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Portfolio of Seth Andrey Jabagat, a junior software developer focused on Microsoft Power Platform, web development, and UI/UX design." />
    <meta name="theme-color" content="#0b1f3a" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="Seth Andrey Jabagat | Developer Portfolio" />
    <meta property="og:description" content="Junior software developer focused on Microsoft Power Platform, web development, and practical user-centered solutions." />
    <meta property="og:url" content="https://seth-jabagat-portfolio.onrender.com/" />
    <title>Seth Andrey Jabagat | @ViewData["Title"]</title>
    <link rel="canonical" href="https://seth-jabagat-portfolio.onrender.com/" />
    <link rel="icon" type="image/svg+xml" href="~/favicon.svg" />
    <script>document.documentElement.classList.add("js");</script>
    <link rel="stylesheet" href="~/css/professional.css" asp-append-version="true" />
</head>
<body>
    <a class="skip-link" href="#main-content">Skip to content</a>

    <header class="site-header" data-header>
        <nav class="nav-shell" aria-label="Main navigation">
            <a class="wordmark" asp-page="/Index" aria-label="Seth's portfolio home">
                <span class="wordmark-mark">SJ</span>
                <span>Seth Jabagat</span>
            </a>

            <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-navigation" data-menu-button>
                <span></span>
                <span></span>
                <span></span>
                <span class="visually-hidden">Toggle navigation</span>
            </button>

            <div class="nav-links" id="site-navigation" data-menu>
                <a href="#about">About</a>
                <a href="#education">Education</a>
                <a href="#skills">Skills</a>
                <a href="#projects">Projects</a>
                <a href="#experience">Experience</a>
                <a asp-page="/Resume">Résumé</a>
                <a class="nav-contact" href="#contact">Contact</a>
            </div>
        </nav>
    </header>

    <main id="main-content">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="footer-inner">
            <p>&copy; @DateTime.Now.Year Seth Andrey Jabagat</p>
            <p>Built with C# and ASP.NET Core &middot; Deployed on Render</p>
        </div>
    </footer>

    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
