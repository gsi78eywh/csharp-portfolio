<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Portfolio of Seth Andrey Jabagat — Junior Software Developer specializing in Microsoft Power Platform, full-stack web applications, and automated workflows." />
    <meta name="theme-color" content="#f8fafc" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="Seth Andrey Jabagat | Developer Portfolio" />
    <meta property="og:description" content="Junior Software Developer specializing in Microsoft Power Platform, full-stack web applications, and practical user-centered solutions." />
    <meta property="og:url" content="https://seth-jabagat-portfolio.onrender.com/" />
    <title>Seth Andrey Jabagat | @ViewData["Title"]</title>
    <link rel="canonical" href="https://seth-jabagat-portfolio.onrender.com/" />
    <link rel="icon" type="image/svg+xml" href="~/favicon.svg" />
    
    <!-- Google Fonts: Inter & JetBrains Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet">

    <script>document.documentElement.classList.add("js");</script>
    <link rel="stylesheet" href="~/css/professional.css" asp-append-version="true" />
</head>
<body class="light-dashboard">
    <a class="skip-link" href="#main-content">Skip to content</a>

    <!-- Mobile Top Navigation (Visible on screen < 1024px) -->
    <header class="mobile-nav-bar" data-mobile-header>
        <a class="mobile-brand" asp-page="/Index">
            <span class="brand-monogram">SJ</span>
            <span class="brand-name">Seth Andrey Jabagat</span>
        </a>
        <div class="mobile-nav-actions">
            <button class="mobile-ai-trigger" type="button" data-open-ai-drawer aria-label="Open AI Assistant">
                <span>🤖 AI</span>
            </button>
            <button class="mobile-menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-nav-drawer" data-menu-button aria-label="Toggle navigation">
                <span></span>
                <span></span>
                <span></span>
            </button>
        </div>
    </header>

    <!-- Mobile Navigation Drawer -->
    <nav class="mobile-nav-drawer" id="mobile-nav-drawer" data-menu aria-label="Mobile Navigation">
        <div class="mobile-nav-links">
            <a href="#about" class="mobile-nav-link"><span class="nav-idx">01</span> About</a>
            <a href="#experience" class="mobile-nav-link"><span class="nav-idx">02</span> Experience</a>
            <a href="#projects" class="mobile-nav-link"><span class="nav-idx">03</span> Projects</a>
            <a href="#credentials" class="mobile-nav-link"><span class="nav-idx">04</span> Credentials &amp; Stack</a>
            <a href="#education" class="mobile-nav-link"><span class="nav-idx">05</span> Education &amp; Background</a>
            <a href="#answers" class="mobile-nav-link"><span class="nav-idx">06</span> Book of Answers</a>
            <a href="#contact" class="mobile-nav-link"><span class="nav-idx">07</span> Contact</a>
            <a asp-page="/Resume" class="mobile-nav-link mobile-nav-link-resume"><span class="nav-idx">📄</span> View Résumé</a>
        </div>
    </nav>

    <div class="site-viewport">
        @RenderBody()
    </div>

    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
