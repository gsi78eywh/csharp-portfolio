@page
@model IndexModel
@{
    ViewData["Title"] = "Developer Portfolio";
}

<div class="portfolio-dashboard" id="main-content">
    
    <!-- LEFT SIDEBAR: Profile & 9-Item Monospace Navigation -->
    <aside class="dashboard-col left-sidebar" aria-label="Profile and Navigation">
        <div class="sidebar-inner">
            <div class="sidebar-top">
                <div class="profile-card">
                    <div class="avatar-frame" title="Seth Andrey Jabagat — Junior Software Developer">
                        <img src="~/images/profile-corporate.jpg" asp-append-version="true" alt="Seth Andrey Jabagat - Professional Corporate Portrait" class="avatar-img" />
                    </div>
                    <div class="profile-meta">
                        <h1 class="profile-name">
                            Seth Andrey Jabagat
                            <span class="verified-badge" title="Verified Developer Profile" aria-label="Verified">
                                <svg viewBox="0 0 24 24" fill="currentColor">
                                    <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/>
                                </svg>
                            </span>
                        </h1>
                        <p class="profile-location">
                            <svg class="icon-pin" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                                <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5a2.5 2.5 0 0 1 0-5 2.5 2.5 0 0 1 0 5z"/>
                            </svg>
                            <a href="@Model.LocationMapUrl" target="_blank" rel="noreferrer" class="profile-location-link" title="View Tabon, Dalaguete, Cebu on Google Maps Street View">
                                <span>Dalaguete, Cebu, Philippines</span>
                                <span class="arrow-glyph">↗</span>
                            </a>
                        </p>
                        <p class="profile-bio">
                            Junior Software Developer focused on Microsoft Power Platform, full-stack web development, and practical workflow automation.
                        </p>
                    </div>

                    <!-- Left-Sidebar Direct Résumé Action -->
                    <div class="sidebar-resume-cta-wrap">
                        <a asp-page="/Resume" class="sidebar-resume-btn" aria-label="View Full Résumé">
                            <span class="sidebar-resume-btn-left">
                                <span class="sidebar-resume-btn-icon">📄</span>
                                <span class="sidebar-resume-btn-label">View Full Résumé</span>
                            </span>
                            <span class="arrow-glyph">↗</span>
                        </a>
                    </div>
                </div>

                <!-- Monospace 7-Item Numbered Navigation -->
                <nav class="sidebar-nav" aria-label="Sections">
                    <ul class="nav-mono-list" id="sidebar-nav-list">
                        <li><a href="#about" class="nav-mono-link active" data-section="about"><span class="nav-num">01</span><span class="nav-sep">—</span><span class="nav-label">about</span><span class="nav-indicator"></span></a></li>
                        <li><a href="#experience" class="nav-mono-link" data-section="experience"><span class="nav-num">02</span><span class="nav-sep">—</span><span class="nav-label">experience</span><span class="nav-indicator"></span></a></li>
                        <li><a href="#projects" class="nav-mono-link" data-section="projects"><span class="nav-num">03</span><span class="nav-sep">—</span><span class="nav-label">projects</span><span class="nav-indicator"></span></a></li>
                        <li><a href="#credentials" class="nav-mono-link" data-section="credentials"><span class="nav-num">04</span><span class="nav-sep">—</span><span class="nav-label">credentials &amp; stack</span><span class="nav-indicator"></span></a></li>
                        <li><a href="#education" class="nav-mono-link" data-section="education"><span class="nav-num">05</span><span class="nav-sep">—</span><span class="nav-label">education &amp; background</span><span class="nav-indicator"></span></a></li>
                        <li><a href="#answers" class="nav-mono-link" data-section="answers"><span class="nav-num">06</span><span class="nav-sep">—</span><span class="nav-label">book of answers</span><span class="nav-indicator"></span></a></li>
                        <li><a href="#contact" class="nav-mono-link" data-section="contact"><span class="nav-num">07</span><span class="nav-sep">—</span><span class="nav-label">contact</span><span class="nav-indicator"></span></a></li>
                    </ul>
                </nav>
            </div>

            <!-- Bottom Schedule a Call Action Button -->
            <div class="sidebar-bottom">
                <a href="mailto:sethandreyabrasado@gmail.com?subject=Schedule%20a%20Call%20with%20Seth" class="schedule-call-btn" aria-label="Schedule a call with Seth">
                    <span class="btn-cal-icon">📅</span>
                    <span>Schedule a Call</span>
                </a>
            </div>
        </div>
    </aside>

    <!-- CENTER COLUMN: Separately Scrollable Main Content Stream -->
    <main class="dashboard-col center-stream" id="center-stream">
        
        <!-- 01 // ABOUT SECTION (Balanced, Realistic & Professional) -->
        <section class="section-card about-hero-card" id="about" aria-labelledby="about-heading">
            <div class="card-meta-header">
                <span class="section-code">01 // ABOUT <span class="dot-accent">•</span></span>
                <span class="location-tag">Cebu, PH</span>
            </div>

            <h2 class="hero-display-title" id="about-heading">
                Junior Software Developer building practical web solutions &amp; automated workflows.
            </h2>

            <div class="hero-body-text">
                <p>
                    Hi, I'm <strong>Seth Andrey Jabagat</strong> — a junior developer and Computer Technology student based in Cebu, Philippines. I focus on building practical tools with <strong>Microsoft Power Platform</strong> (Power Apps, Power Automate, SharePoint) and full-stack web applications using <strong>C# / ASP.NET Core</strong>, <strong>PHP / Laravel</strong>, and <strong>React</strong>.
                </p>
                <p>
                    I enjoy creating reliable solutions that automate everyday tasks, organize data with clean databases, and provide friendly, responsive user experiences.
                </p>
                <p class="hero-availability-callout">
                    Open for <strong>Internship</strong> and <strong>Junior Software Developer</strong> opportunities where I can learn, contribute to a team, and grow.
                </p>
            </div>

            <div class="hero-outlinks-row">
                <a href="https://github.com/gsi78eywh" target="_blank" rel="noreferrer" class="outlink-pill">
                    <span>GitHub</span> <span class="arrow-glyph">↗</span>
                </a>
                <a href="https://www.linkedin.com/in/seth-andrey-abrasado-868419366/" target="_blank" rel="noreferrer" class="outlink-pill">
                    <span>LinkedIn</span> <span class="arrow-glyph">↗</span>
                </a>
                <a href="mailto:sethandreyabrasado@gmail.com" class="outlink-pill">
                    <span>Email</span> <span class="arrow-glyph">↗</span>
                </a>
                <a href="@Model.MicrosoftTeamsChatUrl" target="_blank" rel="noreferrer" class="outlink-pill">
                    <span>Teams</span> <span class="arrow-glyph">↗</span>
                </a>
                <a asp-page="/Resume" class="outlink-pill resume-pill">
                    <span>Résumé</span> <span class="arrow-glyph">↗</span>
                </a>
            </div>
        </section>

        <!-- STAT METRICS GRID: 4 Horizontal Cards with Impact-Driven Metrics -->
        <div class="metrics-grid" aria-label="Key Highlights">
            <article class="metric-card">
                <div class="metric-top">
                    <span class="metric-icon">🖥️</span>
                    <span class="metric-tag">DEVELOPMENT FOCUS</span>
                </div>
                <div class="metric-value">2+ Yrs</div>
                <div class="metric-sub">Hands-on student &amp; project practice</div>
            </article>

            <article class="metric-card">
                <div class="metric-top">
                    <span class="metric-icon">🚀</span>
                    <span class="metric-tag">DEPLOYED PLATFORMS</span>
                </div>
                <div class="metric-value">Production Systems</div>
                <div class="metric-sub">Enterprise, academic &amp; community solutions</div>
            </article>

            <article class="metric-card">
                <div class="metric-top">
                    <span class="metric-icon">⚡</span>
                    <span class="metric-tag">WORKFLOW AUTOMATION</span>
                </div>
                <div class="metric-value">10+ Flows Automated</div>
                <div class="metric-sub">Power Automate &amp; enterprise business logic</div>
            </article>

            <article class="metric-card">
                <div class="metric-top">
                    <span class="metric-icon">☀️</span>
                    <span class="metric-tag">CERTIFIED TRAINING</span>
                </div>
                <div class="metric-value">6+ Certs</div>
                <div class="metric-sub">Google Data, UI/UX, Python Automation</div>
            </article>
        </div>

        <!-- 02 // EXPERIENCE SECTION -->
        <section class="section-card" id="experience" aria-labelledby="experience-heading">
            <div class="card-meta-header">
                <span class="section-code">02 // EXPERIENCE <span class="dot-accent">•</span></span>
                <span class="location-tag">Work &amp; Internships</span>
            </div>
            <h3 class="section-subheading" id="experience-heading">Hands-on software development, enterprise platforms &amp; practical delivery.</h3>

            <div class="work-experience-stream">
                @foreach (var workExp in Model.WorkExperience)
                {
                    <article class="work-experience-card">
                        <div class="work-exp-top">
                            <div class="work-exp-org-wrap">
                                <div class="work-exp-icon">
                                    <span>💼</span>
                                </div>
                                <div class="work-exp-org-info">
                                    <h4 class="work-exp-company">
                                        <a href="@workExp.CompanyUrl" target="_blank" rel="noreferrer" class="work-company-link" title="Visit @workExp.Company website">
                                            <span>@workExp.Company</span>
                                            <span class="arrow-glyph">↗</span>
                                        </a>
                                    </h4>
                                    <div class="work-exp-role">@workExp.Role</div>
                                </div>
                            </div>
                            <div class="work-exp-badges">
                                <span class="work-badge duration-badge">@workExp.Duration</span>
                                <span class="work-badge type-badge">@workExp.Type</span>
                            </div>
                        </div>

                        <p class="work-exp-summary">@workExp.Summary</p>

                        <!-- Projects Handled Sub-Grid -->
                        <div class="work-projects-block">
                            <div class="work-projects-header">
                                <span class="work-projects-label">Projects Handled &amp; Responsibilities</span>
                                <div class="work-projects-header-actions">
                                    @if (!string.IsNullOrEmpty(workExp.RepositoryUrl))
                                    {
                                        <a href="@workExp.RepositoryUrl" target="_blank" rel="noreferrer" class="work-github-pill" title="View repository on GitHub">
                                            <span>GitHub Repo</span>
                                            <span class="arrow-glyph">↗</span>
                                        </a>
                                    }
                                    <span class="work-projects-count">@workExp.ProjectsHandled.Count Projects</span>
                                </div>
                            </div>
                            <div class="work-projects-grid">
                                @foreach (var proj in workExp.ProjectsHandled)
                                {
                                    <div class="work-project-item">
                                        <div class="work-project-item-head">
                                            <span class="work-project-title">@proj.Name</span>
                                            <div class="work-project-badges-wrap">
                                                @if (!string.IsNullOrEmpty(proj.Badge))
                                                {
                                                    <span class="work-project-tag">@proj.Badge</span>
                                                }
                                                @if (!string.IsNullOrEmpty(proj.ProjectUrl))
                                                {
                                                    <a href="@proj.ProjectUrl" target="_blank" rel="noreferrer" class="work-project-code-link" title="View @proj.Name repository on GitHub">
                                                        <span>Code</span>
                                                        <span class="arrow-glyph">↗</span>
                                                    </a>
                                                }
                                            </div>
                                        </div>
                                        <div class="work-project-role-line">
                                            <span class="role-bullet">▸</span> <span class="role-highlight">@proj.Role</span>
                                        </div>
                                        <p class="work-project-item-desc">@proj.Description</p>
                                        @if (!string.IsNullOrEmpty(proj.ImagePath))
                                        {
                                            <button type="button" class="work-project-media-thumb" data-open-preview="true"
                                                    data-preview-title="@proj.Name"
                                                    data-preview-sub="Enterprise Workflow · Ramon Aboitiz Foundation Inc."
                                                    data-preview-desc="@proj.Description"
                                                    data-preview-img="@proj.ImagePath"
                                                    data-preview-badge="RAFI Enterprise System"
                                                    data-preview-alt="@proj.Name System Interface"
                                                    aria-label="View system preview screenshot for @proj.Name">
                                                <img src="@proj.ImagePath" alt="@proj.Name System Interface" class="work-project-thumb-img" loading="lazy" />
                                                <span class="work-project-thumb-badge">🖼️ View System Preview ↗</span>
                                            </button>
                                        }
                                    </div>
                                }
                            </div>
                        </div>

                        @if (!string.IsNullOrEmpty(workExp.WorkflowSupport))
                        {
                            <div class="work-ai-workflow-banner">
                                <span class="ai-sparkle-icon">⚡</span>
                                <span class="ai-workflow-text"><strong>Development Workflow:</strong> @workExp.WorkflowSupport</span>
                            </div>
                        }

                        @if (!string.IsNullOrEmpty(workExp.RepositoryUrl))
                        {
                            <div class="work-repo-bar">
                                <a href="@workExp.RepositoryUrl" target="_blank" rel="noreferrer" class="work-repo-btn">
                                    <span class="repo-icon">📂</span>
                                    <span>View GitHub Repository (OIBSIP)</span>
                                    <span class="arrow-glyph">↗</span>
                                </a>
                                <span class="work-repo-note">Includes Todo App, Stopwatch, Quiz App, and Unit Converter</span>
                            </div>
                        }

                        <div class="work-exp-tech-tags">
                            @foreach (var tech in workExp.Technologies)
                            {
                                <span class="tech-pill">@tech</span>
                            }
                        </div>
                    </article>
                }
            </div>

            <!-- Additional Involvement & Extracurricular Activities -->
            <div class="experience-extra-block">
                <div class="experience-extra-title">
                    <span>Community Involvement &amp; Learning Track</span>
                </div>
                <div class="timeline-container">
                    @foreach (var exp in Model.Experience)
                    {
                        <article class="timeline-card">
                            <div class="timeline-period-badge">@exp.Period</div>
                            <h5 class="timeline-role">@exp.Role</h5>
                            <p class="timeline-desc">@exp.Description</p>
                        </article>
                    }
                </div>
            </div>
        </section>

        <!-- 03 // PROJECTS SECTION (Clear, Direct Captions) -->
        <section class="section-card" id="projects" aria-labelledby="projects-heading">
            <div class="card-meta-header">
                <span class="section-code">03 // PROJECTS <span class="dot-accent">•</span></span>
                <span class="location-tag">Selected Work</span>
            </div>
            <h3 class="section-subheading" id="projects-heading">Systems engineered for real community &amp; business impact.</h3>

            <div class="projects-display-grid">
                @for (var index = 0; index < Model.Projects.Count; index++)
                {
                    var proj = Model.Projects[index];
                    <article class="project-box">
                        <div class="project-box-top">
                            <div class="project-box-header">
                                <span class="project-idx">@((index + 1).ToString("00"))</span>
                                <span class="project-badge status-@proj.Status.ToLower().Replace(" ", "-")">@proj.Status</span>
                            </div>
                            <div class="project-period-txt">@proj.Period</div>
                            <h4 class="project-box-title">@proj.Title</h4>
                            <p class="project-box-desc">@proj.Description</p>
                        </div>

                        <div class="project-box-bottom">
                            <div class="project-tags-list">
                                @foreach (var tech in proj.Technologies)
                                {
                                    <span class="tech-pill">@tech</span>
                                }
                            </div>

                            <div class="project-box-footer">
                                @if (!string.IsNullOrWhiteSpace(proj.RepositoryUrl))
                                {
                                    <a href="@proj.RepositoryUrl" target="_blank" rel="noreferrer" class="project-code-link">
                                        <span>View GitHub repository</span> <span class="arrow-glyph">↗</span>
                                    </a>
                                }
                                else if (!string.IsNullOrWhiteSpace(proj.ImagePath))
                                {
                                    <button type="button" 
                                            class="project-modal-trigger-btn" 
                                            data-open-preview="true"
                                            data-preview-title="@proj.Title"
                                            data-preview-sub="@proj.Period"
                                            data-preview-desc="@proj.Description"
                                            data-preview-img="@proj.ImagePath"
                                            data-preview-badge="RAFI Enterprise System"
                                            data-preview-alt="@proj.ImageAlt"
                                            aria-label="View UI preview screenshot for @proj.Title">
                                        <span class="preview-btn-icon">🖼️</span>
                                        <span>View System Preview</span>
                                        <span class="preview-pill">Modal ↗</span>
                                    </button>
                                }
                                else
                                {
                                    <span class="project-internal-tag">Enterprise / Internal Solution</span>
                                }
                            </div>
                        </div>
                    </article>
                }
            </div>
        </section>

        <!-- 04 // CREDENTIALS & STACK SECTION (Consolidated Tech Stack, Certifications & Coursework) -->
        <section class="section-card" id="credentials" aria-labelledby="credentials-heading">
            <div class="card-meta-header">
                <span class="section-code">04 // CREDENTIALS &amp; STACK <span class="dot-accent">•</span></span>
                <span class="location-tag">Verified Skills &amp; Credentials</span>
            </div>
            <h3 class="section-subheading" id="credentials-heading">Technical proficiency, verified certifications &amp; academic coursework.</h3>

            <!-- Subblock 04.1: Core Technical Stack -->
            <div class="credentials-subblock">
                <div class="credentials-subblock-header">
                    <div class="subblock-title-wrap">
                        <span class="subblock-num">04.1</span>
                        <h4 class="subblock-title">Core Technical Stack &amp; Proficiency</h4>
                    </div>
                    <div class="stack-meta-tools">
                        <span class="stack-action-hint">Click pill to reveal %</span>
                        <button type="button" class="btn-toggle-all-pct" id="btn-toggle-all-pct" title="Toggle all percentages">
                            <span class="pct-toggle-text">Show All %</span>
                            <span class="pct-toggle-icon">⚡</span>
                        </button>
                    </div>
                </div>

                <div class="tech-stack-pills-layout">
                    @foreach (var category in Model.RatedSkills)
                    {
                        <div class="tech-category-group">
                            <h5 class="tech-category-heading">@category.Category.ToUpperInvariant()</h5>
                            <div class="tech-pills-row">
                                @foreach (var skill in category.Skills)
                                {
                                    <button type="button" 
                                            class="tech-pill-btn" 
                                            data-skill-name="@skill.Name"
                                            data-skill-pct="@skill.Percentage"
                                            data-skill-rating="@skill.Rating"
                                            data-skill-level="@skill.Level"
                                            data-skill-desc="@skill.Description"
                                            title="@skill.Name: @skill.Percentage% (@skill.Rating/10) &bull; @skill.Level"
                                            aria-label="@skill.Name @skill.Percentage% proficiency">
                                        <span class="tech-pill-icon">
                                            @await Html.PartialAsync("_SkillIcon", skill.IconKey)
                                        </span>
                                        <span class="tech-pill-label">@skill.Name</span>
                                        <span class="tech-pill-pct-chip">@skill.Percentage%</span>
                                    </button>
                                }
                            </div>
                        </div>
                    }
                </div>

                <!-- Active Skill Highlight Bar (Shown when pill clicked) -->
                <div class="skill-detail-toast" id="skill-detail-toast" style="display: none;" aria-live="polite">
                    <div class="toast-left">
                        <span class="toast-pct-badge" id="toast-pct-badge">90%</span>
                        <div class="toast-meta">
                            <div class="toast-title-row">
                                <strong class="toast-name" id="toast-name">Power Apps</strong>
                                <span class="toast-level" id="toast-level">Advanced (9/10)</span>
                            </div>
                            <p class="toast-desc" id="toast-desc">Custom Canvas &amp; Model-driven applications with responsive multi-screen UX</p>
                        </div>
                    </div>
                    <div class="toast-track">
                        <div class="toast-fill" id="toast-fill" style="width: 90%;"></div>
                    </div>
                    <button type="button" class="toast-close" id="toast-close" aria-label="Close detail">✕</button>
                </div>
            </div>

            <!-- Subblock 04.2: Verified Professional Certifications -->
            <div class="credentials-subblock">
                <div class="credentials-subblock-header">
                    <div class="subblock-title-wrap">
                        <span class="subblock-num">04.2</span>
                        <h4 class="subblock-title">Verified Professional Certifications</h4>
                    </div>
                    <span class="subblock-badge">Industry Credentials</span>
                </div>

                <div class="certs-cards-grid">
                    <div class="cert-feature-card">
                        <div class="cert-card-top">
                            <span class="cert-track">Python / Automation</span>
                            <span class="cert-verified-icon">✓</span>
                        </div>
                        <h5 class="cert-card-title">Using Python to Interact with the Operating System</h5>
                        <span class="cert-card-issuer">Google / Coursera</span>
                    </div>

                    <div class="cert-feature-card">
                        <div class="cert-card-top">
                            <span class="cert-track">Programming</span>
                            <span class="cert-verified-icon">✓</span>
                        </div>
                        <h5 class="cert-card-title">Crash Course on Python</h5>
                        <span class="cert-card-issuer">Google / Coursera</span>
                    </div>

                    <div class="cert-feature-card">
                        <div class="cert-card-top">
                            <span class="cert-track">Data Analytics</span>
                            <span class="cert-verified-icon">✓</span>
                        </div>
                        <h5 class="cert-card-title">Google Data Analytics Professional Specialization</h5>
                        <span class="cert-card-issuer">Google Career Certificates</span>
                    </div>

                    <div class="cert-feature-card">
                        <div class="cert-card-top">
                            <span class="cert-track">Design &amp; UI/UX</span>
                            <span class="cert-verified-icon">✓</span>
                        </div>
                        <h5 class="cert-card-title">Google UI/UX Design Fundamentals</h5>
                        <span class="cert-card-issuer">Google / Coursera</span>
                    </div>
                </div>
            </div>

            <!-- Subblock 04.3: Academic Coursework -->
            <div class="credentials-subblock">
                <div class="credentials-subblock-header">
                    <div class="subblock-title-wrap">
                        <span class="subblock-num">04.3</span>
                        <h4 class="subblock-title">Academic Coursework (USJ-R)</h4>
                    </div>
                    <span class="subblock-badge">Core Curriculum</span>
                </div>

                <div class="courses-list-grid">
                    @foreach (var course in Model.AcademicCourses)
                    {
                        <div class="course-list-item">
                            <div class="course-idx-bullet">▸</div>
                            <div class="course-body">
                                <h5 class="course-name">@course.Title</h5>
                                <span class="course-track-sub">@course.Category</span>
                                <span class="course-tag">@course.Status</span>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </section>

        <!-- 05 // EDUCATION & BACKGROUND -->
        <section class="section-card" id="education" aria-labelledby="education-heading">
            <div class="card-meta-header">
                <span class="section-code">05 // EDUCATION &amp; BACKGROUND <span class="dot-accent">•</span></span>
                <span class="location-tag">Academic Foundation</span>
            </div>
            <h3 class="section-subheading" id="education-heading">Formal degrees, technical scholarship training &amp; academic foundation.</h3>

            <div class="education-cards-grid">
                @for (var index = 0; index < Model.Education.Count; index++)
                {
                    var edu = Model.Education[index];
                    <a href="@edu.WebsiteUrl" target="_blank" rel="noreferrer" class="edu-link-card">
                        <div class="edu-logo-box">
                            <img src="@edu.ImagePath" alt="@edu.ImageAlt" class="edu-logo-img @(edu.UseContainedImage ? "contain-img" : "")" />
                        </div>
                        <div class="edu-details">
                            <div class="edu-period">@edu.Period</div>
                            <h4 class="edu-program">@edu.Program</h4>
                            <p class="edu-school">@edu.School</p>
                            <span class="edu-visit">Visit Institution <span class="arrow-glyph">↗</span></span>
                        </div>
                    </a>
                }
            </div>
