@page
@model IndexModel
@{
    ViewData["Title"] = "Developer Portfolio";
}

<section class="hero section-shell" aria-labelledby="hero-title">
    <div class="hero-copy reveal">
        <p class="availability"><span aria-hidden="true"></span> Open to internships and junior developer roles</p>
        <p class="hero-location">@Model.Location</p>
        <h1 id="hero-title">Seth Andrey <span>Jabagat</span></h1>
        <p class="hero-role">@Model.Role</p>
        <p class="hero-summary">
            Computer Technology student building practical business and community solutions with
            Microsoft Power Platform, ASP.NET Core, Laravel, and responsive UI design.
        </p>
        <div class="hero-actions">
            <a class="button button-primary" href="#projects">View selected projects</a>
            <a class="button button-secondary" asp-page="/Resume">View résumé</a>
            <a class="text-link" href="mailto:sethandreyabrasado@gmail.com">Email me <span aria-hidden="true">↗</span></a>
        </div>
        <dl class="hero-facts" aria-label="Professional profile summary">
            <div><dt>Focus</dt><dd>Automation &amp; web solutions</dd></div>
            <div><dt>Core platform</dt><dd>Microsoft Power Platform</dd></div>
            <div><dt>Availability</dt><dd>Internship &amp; junior roles</dd></div>
        </dl>
    </div>

    <div class="hero-profile reveal" aria-label="Seth Jabagat professional profile">
        <div class="profile-monogram" aria-hidden="true">SJ</div>
        <div class="profile-heading">
            <div>
                <p>Developer profile</p>
                <h2>Seth Jabagat</h2>
            </div>
            <span class="owner-badge" title="Portfolio owner" aria-label="Portfolio owner badge">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m7 12.5 3.1 3.1L17.5 8" /></svg>
            </span>
        </div>
        <ul class="profile-capabilities" aria-label="Primary capabilities">
            <li><span>01</span> Power Apps &amp; Power Automate</li>
            <li><span>02</span> C# &amp; ASP.NET Core</li>
            <li><span>03</span> Laravel &amp; MySQL</li>
            <li><span>04</span> Responsive UI/UX</li>
        </ul>
        <div class="profile-status"><i aria-hidden="true"></i> Available for opportunities</div>
    </div>
</section>

<div class="capability-bar" aria-label="Professional capabilities">
    <div class="section-shell">
        <span>Microsoft Power Platform</span>
        <span>Workflow Automation</span>
        <span>ASP.NET Core</span>
        <span>UI/UX Design</span>
        <span>Cloud Deployment</span>
    </div>
</div>

<section class="about section-shell section-block" id="about" aria-labelledby="about-title">
    <div class="section-heading reveal">
        <p class="section-label">01 · Profile</p>
        <h2 id="about-title">Technology that solves a clear problem.</h2>
    </div>
    <div class="about-content reveal">
        <p class="lead">
            I translate workflow and community needs into simple, usable digital products.
        </p>
        <p>
            My experience spans Microsoft low-code solutions, full-stack school projects, responsive interfaces,
            and cloud deployment. I value clear communication, thoughtful design, and reliable execution.
        </p>
        <ul class="value-list" aria-label="Professional strengths">
            <li><strong>User-centered</strong><span>Interfaces designed for clarity and accessibility.</span></li>
            <li><strong>Process-minded</strong><span>Workflows organized around real operating needs.</span></li>
            <li><strong>Team-ready</strong><span>Collaborative, adaptable, and committed to learning.</span></li>
        </ul>
    </div>
</section>

<section class="education section-block" id="education" aria-labelledby="education-title">
    <div class="section-shell">
        <div class="section-heading section-heading-row reveal">
            <div>
                <p class="section-label">02 · Education</p>
                <h2 id="education-title">Academic foundation.</h2>
            </div>
            <p>Formal studies and scholarship training supporting my software development practice.</p>
        </div>

        <div class="education-grid">
            @for (var index = 0; index < Model.Education.Count; index++)
            {
                var education = Model.Education[index];
                <a class="education-card reveal"
                   href="@education.WebsiteUrl"
                   target="_blank"
                   rel="noreferrer"
                   aria-label="Visit the official website of @education.School">
                    <div class="education-logo-wrap">
                        <img class="education-logo @(education.UseContainedImage ? "education-logo--contain" : null)"
                             src="@education.ImagePath"
                             alt="@education.ImageAlt"
                             loading="lazy"
                             decoding="async" />
                    </div>
                    <div class="education-card-content">
                        <span class="card-number">@((index + 1).ToString("00"))</span>
                        <p>@education.Period</p>
                        <h3>@education.Program</h3>
                        <span class="education-school">@education.School</span>
                        <span class="card-link">Visit institution <b aria-hidden="true">↗</b></span>
                    </div>
                </a>
            }
        </div>
    </div>
</section>

<section class="skills section-block" id="skills" aria-labelledby="skills-title">
    <div class="section-shell">
        <div class="section-heading section-heading-row reveal">
            <div>
                <p class="section-label">03 · Capabilities</p>
                <h2 id="skills-title">Focused tools for delivery.</h2>
            </div>
            <p>A practical stack for Microsoft workflows, responsive applications, data, and deployment.</p>
        </div>

        <div class="stack-grid">
            @for (var index = 0; index < Model.TechStack.Count; index++)
            {
                var group = Model.TechStack[index];
                <article class="stack-card reveal">
                    <div class="stack-card-heading">
                        <span>@((index + 1).ToString("00"))</span>
                        <h3>@group.Category</h3>
                    </div>
                    <ul>
                        @foreach (string skill in group.Skills)
                        {
                            <li>@skill</li>
                        }
                    </ul>
                </article>
            }
        </div>

        <div class="training reveal" aria-labelledby="training-title">
            <div>
                <p class="section-label">Training</p>
                <h3 id="training-title">Continued professional learning</h3>
            </div>
            <ul>
                @foreach (string certification in Model.Certifications)
                {
                    <li>@certification</li>
                }
            </ul>
        </div>
    </div>
</section>

<section class="projects section-shell section-block" id="projects" aria-labelledby="projects-title">
    <div class="section-heading section-heading-row reveal">
        <div>
            <p class="section-label">04 · Selected work</p>
            <h2 id="projects-title">Projects with a purpose.</h2>
        </div>
        <p>Academic, company, and community work focused on useful outcomes and clear user experiences.</p>
    </div>

    <div class="project-grid">
        @for (var index = 0; index < Model.Projects.Count; index++)
        {
            var project = Model.Projects[index];
            <article class="project-card reveal">
                <div class="project-header">
                    <span class="project-number">@((index + 1).ToString("00"))</span>
                    <span class="project-status">@project.Status</span>
                </div>
                <p class="project-period">@project.Period</p>
                <h3>@project.Title</h3>
                <p class="project-description">@project.Description</p>
                <ul aria-label="Technologies used for @project.Title">
                    @foreach (string technology in project.Technologies)
                    {
                        <li>@technology</li>
                    }
                </ul>
                @if (!string.IsNullOrWhiteSpace(project.RepositoryUrl))
                {
                    <a class="project-link" href="@project.RepositoryUrl" target="_blank" rel="noreferrer">
                        View GitHub repository <span aria-hidden="true">↗</span>
                    </a>
                }
                else
                {
                    <span class="project-private">Repository not public</span>
                }
            </article>
        }
    </div>
</section>

<section class="experience section-block" id="experience" aria-labelledby="experience-title">
    <div class="section-shell experience-layout">
        <div class="section-heading reveal">
            <p class="section-label">05 · Experience</p>
            <h2 id="experience-title">Learning through contribution.</h2>
            <p>Community, industry, and collaborative development experiences.</p>
        </div>

        <div class="timeline">
            @foreach (var experience in Model.Experience)
            {
                <article class="timeline-item reveal">
                    <p>@experience.Period</p>
                    <h3>@experience.Role</h3>
                    <span>@experience.Description</span>
                </article>
            }
        </div>
    </div>
</section>

<section class="motivation section-shell" aria-labelledby="motivation-title">
    <div class="quote-card reveal">
        <div>
            <p class="section-label" id="motivation-title">Daily perspective</p>
            <span class="quote-update">Updated daily</span>
        </div>
        <blockquote>
            <p>“@Model.Quote.Text”</p>
            <footer>— @Model.Quote.Author</footer>
        </blockquote>
        @if (Model.Quote.IsFromApi)
        {
            <a class="quote-credit" href="https://zenquotes.io/" target="_blank" rel="noreferrer">Quote provided by ZenQuotes API</a>
        }
        else
        {
            <span class="quote-credit">Saved quote shown while the daily service reconnects.</span>
        }
    </div>
</section>

<section class="contact section-block" id="contact" aria-labelledby="contact-title">
    <div class="contact-inner section-shell reveal">
        <p class="section-label">06 · Contact</p>
        <h2 id="contact-title">Let’s discuss how I can contribute.</h2>
        <p>I’m available for internships, junior roles, and project opportunities in Microsoft solutions and web development.</p>
        <div class="contact-actions">
            <a class="button button-light" href="mailto:sethandreyabrasado@gmail.com">Send an email</a>
            <a class="button button-outline-light" href="@Model.MicrosoftTeamsChatUrl" target="_blank" rel="noreferrer">Chat on Teams</a>
        </div>
        <div class="social-links" aria-label="Professional profiles">
            <a href="https://github.com/gsi78eywh" target="_blank" rel="noreferrer">GitHub ↗</a>
            <a href="https://www.linkedin.com/in/seth-andrey-abrasado-868419366/" target="_blank" rel="noreferrer">LinkedIn ↗</a>
            <a href="https://www.facebook.com/profile.php?id=61582551204852" target="_blank" rel="noreferrer">Facebook ↗</a>
        </div>
    </div>
</section>

<a class="teams-support" href="@Model.MicrosoftTeamsChatUrl" target="_blank" rel="noreferrer" aria-label="Chat with Seth on Microsoft Teams">
    <span aria-hidden="true">T</span>
    <strong>Teams chat</strong>
</a>
