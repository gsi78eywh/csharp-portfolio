@page
@model IndexModel
@{
    ViewData["Title"] = "Portfolio";
}

<section class="hero section-shell" aria-labelledby="hero-title">
    <div class="hero-copy reveal">
        <p class="eyebrow"><span></span> Open to Microsoft-focused development opportunities</p>
        <p class="hero-location">@Model.Location</p>
        <h1 id="hero-title">
            Seth Andrey<br />
            <span>Jabagat.</span>
            <span class="owner-badge" role="img" aria-label="Portfolio owner badge" title="Portfolio owner">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m7 12.5 3.1 3.1L17.5 8" /></svg>
            </span>
        </h1>
        <p class="hero-role">@Model.Role</p>
        <p class="hero-summary">
            I build clear, practical digital solutions with Microsoft Power Platform, responsive web
            technologies, and user-centered design&mdash;from workflow automation to community-focused systems.
        </p>
        <div class="hero-actions">
            <a class="button button-primary" href="@Model.MicrosoftTeamsChatUrl" target="_blank" rel="noreferrer">
                Chat on Microsoft Teams <span aria-hidden="true">↗</span>
            </a>
            <a class="button button-secondary" href="mailto:sethandreyabrasado@gmail.com">Send an email</a>
            <a class="text-link" asp-page="/Resume">View résumé <span aria-hidden="true">→</span></a>
        </div>
        <ul class="hero-meta" aria-label="Professional summary">
            <li><strong>Core platform</strong><span>Microsoft Power Platform</span></li>
            <li><strong>Build focus</strong><span>Business &amp; community solutions</span></li>
            <li><strong>Delivery</strong><span>Web &middot; Cloud &middot; Automation</span></li>
        </ul>
    </div>

    <div class="hero-visual reveal" aria-label="Developer profile visual">
        <div class="portrait-card">
            <div class="portrait-grid"></div>
            <div class="initials" aria-hidden="true">SJ</div>
            <span class="orbit orbit-one"></span>
            <span class="orbit orbit-two"></span>
            <div class="status-card">
                <span class="status-dot"></span>
                <div>
                    <small>Current status</small>
                    <strong>Open to opportunities</strong>
                </div>
            </div>
        </div>
        <div class="code-window" aria-hidden="true">
            <div class="window-bar"><i></i><i></i><i></i><span>seth.profile</span></div>
            <pre><code><em>const</em> developer = {
  location: <b>"Cebu, PH"</b>,
  craft: [<b>"Power Platform Developer"</b>, <b>"UI/UX Designer"</b>],
  learning: <mark>true</mark>
};</code></pre>
        </div>
    </div>
</section>

<div class="discipline-strip" aria-label="Professional disciplines">
    <div>
        <span>Microsoft Power Platform</span><i>✦</i>
        <span>UI/UX Design</span><i>✦</i>
        <span>Workflow Automation</span><i>✦</i>
        <span>ASP.NET Core</span><i>✦</i>
        <span>Cloud Deployment</span>
    </div>
</div>

<section class="about section-shell section-block" id="about" aria-labelledby="about-title">
    <div class="section-heading reveal">
        <p class="section-number">01 / Professional profile</p>
        <h2 id="about-title">Practical solutions.<br />Clear experiences.</h2>
    </div>
    <div class="about-content reveal">
        <p class="lead">
            Hi, I'm Seth — a Computer Technology student from Dalaguete, Cebu specializing in software
            development, Microsoft Power Platform solutions, UI/UX design, and responsive web experiences.
        </p>
        <p>
            I focus on building user-centered applications, automating practical workflows, and creating intuitive
            interfaces that make technology easier to understand and use. I bring an adaptable, detail-oriented,
            and collaborative approach to every project.
        </p>
        <p>
            Through academic, company, and community projects, I have designed responsive systems, Power Platform
            workflows, reporting tools, and communication-focused solutions. I am ready to contribute within the
            Microsoft ecosystem while continuing to grow across cloud, web, and automation technologies.
        </p>
        <div class="learning-note">
            <span aria-hidden="true">↗</span>
            <p><strong>What I bring</strong> Curiosity, thoughtful visual decisions, reliable collaboration, and the discipline to keep improving.</p>
        </div>
    </div>
</section>

<section class="education section-block" id="education" aria-labelledby="education-title">
    <div class="section-shell">
        <div class="section-heading horizontal reveal">
            <div>
                <p class="section-number">02 / Learning foundation</p>
                <h2 id="education-title">Education that supports the work.</h2>
            </div>
            <p>A technology-focused academic foundation supported by practical projects and continuous self-learning.</p>
        </div>

        <div class="education-grid">
            @for (var index = 0; index < Model.Education.Count; index++)
            {
                var education = Model.Education[index];
                <article class="education-card reveal">
                    <span class="card-index">@((index + 1).ToString("00"))</span>
                    <p>@education.Period</p>
                    <h3>@education.Program</h3>
                    <span>@education.School</span>
                </article>
            }
        </div>
    </div>
</section>

<section class="skills section-block" id="skills" aria-labelledby="skills-title">
    <div class="section-shell">
        <div class="section-heading horizontal reveal">
            <div>
                <p class="section-number">03 / Core capabilities</p>
                <h2 id="skills-title">A focused Microsoft-first toolkit.</h2>
            </div>
            <p>A practical stack for automating workflows, building responsive interfaces, managing data, and deploying reliable solutions.</p>
        </div>

        <div class="stack-grid">
            @for (var index = 0; index < Model.TechStack.Count; index++)
            {
                var group = Model.TechStack[index];
                <article class="stack-card reveal">
                    <div class="stack-card-heading">
                        <span>@((index + 1).ToString("00"))</span>
                        <h3>@group.Category</h3>
                    </div>
                    <ul>
                        @foreach (string skill in group.Skills)
                        {
                            <li>@skill</li>
                        }
                    </ul>
                </article>
            }
        </div>

        <div class="certifications reveal" aria-labelledby="certifications-title">
            <div>
                <p class="section-number">Training &amp; certifications</p>
                <h3 id="certifications-title">Continuous learning, applied.</h3>
            </div>
            <ol>
                @for (var index = 0; index < Model.Certifications.Count; index++)
                {
                    <li><span>@((index + 1).ToString("00"))</span>@Model.Certifications[index]</li>
                }
            </ol>
        </div>
    </div>
</section>

<section class="projects section-shell section-block" id="projects" aria-labelledby="projects-title">
    <div class="section-heading horizontal reveal">
        <div>
            <p class="section-number">04 / Selected solutions</p>
            <h2 id="projects-title">Built around real needs.</h2>
        </div>
        <p>Academic, company, and community-focused projects where technology, thoughtful design, and practical outcomes come together.</p>
    </div>

    <div class="project-list">
        @for (var index = 0; index < Model.Projects.Count; index++)
        {
            var project = Model.Projects[index];
            <article class="project-card reveal">
                <div class="project-index">@((index + 1).ToString("00"))</div>
                <div class="project-body">
                    <div class="project-topline">
                        <div>
                            <p class="project-period">@project.Period</p>
                            <h3>@project.Title</h3>
                        </div>
                        <span>@project.Status</span>
                    </div>
                    <p>@project.Description</p>
                    <ul aria-label="Key areas for @project.Title">
                        @foreach (string technology in project.Technologies)
                        {
                            <li>@technology</li>
                        }
                    </ul>
                </div>
                <span class="project-arrow" aria-hidden="true">↗</span>
            </article>
        }
    </div>
</section>

<section class="experience section-block" id="experience" aria-labelledby="experience-title">
    <div class="section-shell experience-layout">
        <div class="section-heading reveal">
            <p class="section-number">05 / Experience &amp; involvement</p>
            <h2 id="experience-title">Learning by contributing.</h2>
            <p>Community programs, industry talks, and collaborative development experiences that expand my perspective.</p>
        </div>

        <div class="timeline">
            @foreach (var experience in Model.Experience)
            {
                <article class="timeline-item reveal">
                    <span class="timeline-dot"></span>
                    <p>@experience.Period</p>
                    <h3>@experience.Role</h3>
                    <span>@experience.Description</span>
                </article>
            }
        </div>
    </div>
</section>

<section class="motivation section-shell section-block" aria-labelledby="motivation-title">
    <div class="quote-card reveal">
        <div class="quote-label">
            <p class="section-number" id="motivation-title">Daily perspective</p>
            <span>Updated every day</span>
        </div>
        <blockquote>
            <p>“@Model.Quote.Text”</p>
            <footer>— @Model.Quote.Author</footer>
        </blockquote>
        @if (Model.Quote.IsFromApi)
        {
            <a class="quote-credit" href="https://zenquotes.io/" target="_blank" rel="noreferrer">Inspirational quote provided by ZenQuotes API</a>
        }
        else
        {
            <span class="quote-credit">Showing a saved quote while the daily service reconnects.</span>
        }
    </div>
</section>

<section class="contact section-block" id="contact" aria-labelledby="contact-title">
    <div class="contact-inner section-shell reveal">
        <p class="section-number">06 / Connect</p>
        <h2 id="contact-title">Let's build something<br /><span>useful together.</span></h2>
        <p>
            I'm open to internships, freelance projects, and full-time opportunities involving Microsoft Power
            Platform, workflow automation, responsive web solutions, and user-centered design.
        </p>
        <div class="contact-actions">
            <a class="button button-light" href="@Model.MicrosoftTeamsChatUrl" target="_blank" rel="noreferrer">
                Start a Teams chat <span aria-hidden="true">↗</span>
            </a>
            <a class="button button-outline-light" href="mailto:sethandreyabrasado@gmail.com">Send an email</a>
        </div>
        <div class="social-links" aria-label="Social profiles">
            <a href="https://github.com/gsi78eywh" target="_blank" rel="noreferrer">GitHub</a>
            <a href="https://www.linkedin.com/in/seth-andrey-abrasado-868419366/" target="_blank" rel="noreferrer">LinkedIn</a>
            <a href="https://www.facebook.com/profile.php?id=61582551204852" target="_blank" rel="noreferrer">Facebook</a>
            <a href="https://instagram.com/uj2uw3.xx" target="_blank" rel="noreferrer">Instagram</a>
        </div>
        <div class="community-note">
            <strong>Clear communication matters.</strong>
            <span>I value thoughtful collaboration, reliable follow-through, and solutions people can use with confidence.</span>
        </div>
    </div>
</section>

<a class="teams-support" href="@Model.MicrosoftTeamsChatUrl" target="_blank" rel="noreferrer" aria-label="Chat with Seth on Microsoft Teams">
    <span class="teams-support-icon" aria-hidden="true">T</span>
    <span><small>Microsoft Teams</small><strong>Chat with Seth</strong></span>
</a>
